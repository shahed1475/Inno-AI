{
  "name": "inno-ai",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Food ingredient compliance checker for EU and US additive rules: Cloudflare Worker + D1 (SQLite)",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "db:migrate": "wrangler d1 migrations apply inno-ai-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
